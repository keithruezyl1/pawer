<?xml version="1.0" encoding="utf-8"?>
<!--
  The dashboard status card, at widget scale (DG §7.1 grid, §5 surface).

  Same four slots in the same order as StatusField: tag / display-or-countdown / line 3 / line 4,
  ink on the state fill, 2 dp ink border and the hard 4 dp shadow from the background drawable.
  The headline uses the app's own display face so the widget and the card read as one thing.

  NOTHING ELLIPSISES. Every text slot autosizes within a capped number of lines, so at a 2x2 the
  type shrinks to fit instead of cutting a word off. autoSizeTextType needs API 26, so each
  android:textSize is the size that fits the WIDEST string that slot can hold, unaided, and
  doubles as the API 24-25 fallback; autosize only ever grows it from there.

  The right and bottom padding carry an extra 4 dp because the background insets the card by that
  much to make room for its own shadow, and padding applies to the whole view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pawer_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingLeft="11dp"
  android:paddingTop="10dp"
  android:paddingRight="15dp"
  android:paddingBottom="14dp"
  android:background="@drawable/pawer_bg_clear">

  <TextView
    android:id="@+id/pawer_tag"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="9sp"
    android:letterSpacing="0.06"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="7sp"
    android:autoSizeMaxTextSize="10sp"
    android:text="TODAY" />

  <!-- Either the display word or the countdown is visible, never both. -->
  <TextView
    android:id="@+id/pawer_display"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:layout_marginTop="3dp"
    android:textSize="13sp"
    android:fontFamily="@font/getai_black"
    android:textColor="@color/pawer_ink"
    android:maxLines="2"
    android:lineSpacingMultiplier="0.95"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="12sp"
    android:autoSizeMaxTextSize="23sp"
    android:text="Clear" />

  <!-- Autosizes like the rest. A countdown runs up to 23:59:59, which at a fixed 20sp overruns
       the 84dp content box by 14dp and gets cut off. The size steps only when the digit count
       changes, not on every tick. The 16sp base fits the widest countdown unaided, for API 24-25. -->
  <Chronometer
    android:id="@+id/pawer_countdown"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:layout_marginTop="3dp"
    android:textSize="16sp"
    android:fontFamily="@font/getai_black"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="12sp"
    android:autoSizeMaxTextSize="22sp"
    android:visibility="gone" />

  <TextView
    android:id="@+id/pawer_line3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:textSize="7sp"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="6sp"
    android:autoSizeMaxTextSize="12sp"
    android:text="No scheduled outage" />

  <TextView
    android:id="@+id/pawer_line4"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/pawer_pill"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:textSize="9sp"
    android:textColor="@color/pawer_ink"
    android:maxLines="2"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="7sp"
    android:autoSizeMaxTextSize="10sp"
    android:text="" />
</LinearLayout>
