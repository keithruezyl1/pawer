<?xml version="1.0" encoding="utf-8"?>
<!-- DESIGN-GUIDELINES §7.1 grid: tag / display-or-countdown / line 3 / line 4. All type is ink
     on the state fill; the 2dp ink border comes from the background drawable; no shadow in the
     widget (§7.4). Sizes in sp so user font scaling applies; drop order handled by maxLines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pawer_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/pawer_bg_clear">

  <TextView
    android:id="@+id/pawer_tag"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="11sp"
    android:textColor="@color/pawer_ink"
    android:alpha="0.7"
    android:maxLines="1"
    android:text="TODAY" />

  <!-- Either the display word or the system-driven countdown is visible, never both. -->
  <TextView
    android:id="@+id/pawer_display"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textSize="28sp"
    android:textStyle="bold"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:ellipsize="none"
    android:text="Clear" />

  <Chronometer
    android:id="@+id/pawer_countdown"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textSize="28sp"
    android:textStyle="bold"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:visibility="gone" />

  <TextView
    android:id="@+id/pawer_line3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:textSize="13sp"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="No scheduled outage" />

  <TextView
    android:id="@+id/pawer_line4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textSize="11sp"
    android:textColor="@color/pawer_ink"
    android:alpha="0.7"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="" />
</LinearLayout>
