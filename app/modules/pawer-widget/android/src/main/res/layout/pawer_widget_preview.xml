<?xml version="1.0" encoding="utf-8"?>
<!--
  PICKER PREVIEW ONLY, never inflated by the provider. Regenerated from pawer_widget.xml.

  The dashboard status card, at widget scale (DG §7.1 grid, §5 surface).

  Same four slots in the same order as StatusField: tag / display-or-countdown / line 3 / line 4,
  ink on the state fill, 2 dp ink border and the hard 4 dp shadow from the background drawable.
  The headline is drawn as a bitmap in the app's process so it is genuinely Getai Grotesk Black,
  the dashboard card's face (Headline.kt). The countdown cannot be a bitmap and still tick for
  free, so it stays a Chronometer in the platform's heaviest weight.

  NOTHING ELLIPSISES. Every text slot autosizes within a capped number of lines, so at a 2x2 the
  type shrinks to fit instead of cutting a word off. autoSizeTextType needs API 26, so each
  android:textSize is the size that fits the WIDEST string that slot can hold, unaided, and
  doubles as the API 24-25 fallback; autosize only ever grows it from there.

  The right and bottom padding carry an extra 4 dp because the background insets the card by that
  much to make room for its own shadow, and padding applies to the whole view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pawer_preview_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingLeft="11dp"
  android:paddingTop="10dp"
  android:paddingRight="15dp"
  android:paddingBottom="14dp"
  android:background="@drawable/pawer_bg_clear">

  <TextView
    android:id="@+id/pawer_preview_tag"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="9sp"
    android:letterSpacing="0.06"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="7sp"
    android:autoSizeMaxTextSize="10sp"
    android:text="TODAY" />

  <!-- Either the headline or the countdown is visible, never both. The headline is an ImageView
       because the text is drawn in the app's process (see Headline.kt) so that no launcher or OEM
       skin can substitute the face. Its size and wrapping are decided there, not here. -->
  <!-- Preview only. The real layout draws this as a bitmap, which nothing fills in the picker,
       so the preview would show an empty headline. Text here, in the heaviest platform weight. -->
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textSize="13sp"
    android:fontFamily="sans-serif-black"
    android:textColor="@color/pawer_ink"
    android:maxLines="2"
    android:text="No outages today" />

  <!-- Autosizes like the rest. A countdown runs up to 23:59:59, which at a fixed 20sp overruns
       the 84dp content box by 14dp and gets cut off. The size steps only when the digit count
       changes, not on every tick. The 16sp base fits the widest countdown unaided, for API 24-25. -->
  <Chronometer
    android:id="@+id/pawer_preview_countdown"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:textSize="16sp"
    android:fontFamily="sans-serif-black"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="12sp"
    android:autoSizeMaxTextSize="22sp"
    android:visibility="gone" />

  <TextView
    android:id="@+id/pawer_preview_line3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:textSize="7sp"
    android:textStyle="bold"
    android:textColor="@color/pawer_ink"
    android:maxLines="1"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="6sp"
    android:autoSizeMaxTextSize="9sp"
    android:text="No scheduled outage" />

  <!-- The slack sits HERE, between the subtitle and the area chip: the tag, value and subtitle
       group tight at the top, and the chip stays pinned to the bottom of the card. Putting this
       after the chip instead pulled the chip up with the value block. -->
  <Space
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:id="@+id/pawer_preview_line4"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:background="@drawable/pawer_pill"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:textSize="9sp"
    android:textStyle="bold"
    android:textColor="@color/pawer_ink"
    android:maxLines="2"
    android:autoSizeTextType="uniform"
    android:autoSizeMinTextSize="7sp"
    android:autoSizeMaxTextSize="10sp"
    android:text="Lahug" />
</LinearLayout>
