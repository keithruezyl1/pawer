<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard status card, as a widget (DG §5 + §7.4). Two layers: the hard ink shadow block
     offset 4dp down-right, then the card inset by the same 4dp so the shadow lands INSIDE the
     widget bounds. The 22dp radius sits ABOVE any launcher's own corner rounding, so the card's
     curve is inside the clip and its corners come out whole. No blur, matching every other surface in the app.
     Generated shape: keep the fill in sync with the palette. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:left="4dp" android:top="4dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/pawer_ink" />
      <corners android:radius="22dp" />
    </shape>
  </item>
  <item android:right="4dp" android:bottom="4dp">
    <shape android:shape="rectangle">
      <solid android:color="#FF5C5C" />
      <stroke android:width="2dp" android:color="@color/pawer_ink" />
      <corners android:radius="22dp" />
    </shape>
  </item>
</layer-list>
