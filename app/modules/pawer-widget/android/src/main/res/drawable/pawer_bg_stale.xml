<?xml version="1.0" encoding="utf-8"?>
<!-- STALE treatment (DG §4.5): dashed slate border over a muted ground. Applied regardless of state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="#E9E9E7" />
  <stroke android:width="2dp" android:color="@color/pawer_slate" android:dashWidth="6dp" android:dashGap="4dp" />
  <corners android:radius="2dp" />
</shape>
