<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard status card, as a widget (DG §5 + §7.4). Two layers: the hard ink shadow block
     offset 4dp down-right, then the card inset by the same 4dp so the shadow lands INSIDE the
     widget bounds and no launcher clips it. No blur, matching every other surface in the app.
     Generated shape: keep the fill in sync with the palette. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:left="4dp" android:top="4dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/pawer_slate" />
      <corners android:radius="14dp" />
    </shape>
  </item>
  <item android:right="4dp" android:bottom="4dp">
    <shape android:shape="rectangle">
      <solid android:color="#E9E9E7" />
      <stroke android:width="2dp" android:color="@color/pawer_slate" android:dashWidth="6dp" android:dashGap="4dp" />
      <corners android:radius="14dp" />
    </shape>
  </item>
</layer-list>
