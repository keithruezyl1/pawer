{
  "name": "pawer",
  "private": true,
  "version": "0.1.0",
  "description": "PAWER — scheduled power-interruption alerts for Visayan Electric's Metro Cebu franchise",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "pipeline",
    "app"
  ],
  "scripts": {
    "start": "npm start -w @pawer/app",
    "android": "npm run android -w @pawer/app",
    "build:registry": "npm run build -w @pawer/registry",
    "test": "npm run test:widget && npm run test -w @pawer/shared -w @pawer/registry -w @pawer/parser -w @pawer/pipeline",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contrast": "npm run contrast -w @pawer/shared",
    "ingest": "npm run ingest -w @pawer/pipeline",
    "maps": "npx tsx pipeline/src/maps/cli.ts",
    "publish": "npx tsx pipeline/src/cli.ts publish",
    "centroids": "npx tsx packages/registry/scripts/source-centroids.ts",
    "centroids:verify": "npx tsx packages/registry/scripts/mark-verified.ts",
    "test:widget": "node app/modules/pawer-widget/scripts/check-remoteviews.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
